[Unit]
Description=Tabminal Web Terminal Service
After=network.target

[Service]
Type=simple
User=liming
WorkingDirectory=/home/liming/dev/Tabminal
ExecStart=/home/liming/dev/Tabminal/dist/tabminal-linux-x64 -h 0.0.0.0 -p 5566 -a 123456 -y
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/liming/dev/Tabminal/tabminal.log
StandardError=append:/home/liming/dev/Tabminal/tabminal-error.log

[Install]
WantedBy=multi-user.target

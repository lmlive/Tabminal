# Tabminal Configuration Example
# Copy this file to .env and modify as needed

# Server Configuration
# --------------------
# Host address to bind to (0.0.0.0 for all interfaces)
TABMINAL_HOST=0.0.0.0

# Port to listen on
TABMINAL_PORT=9846

# Security (REQUIRED)
# -----------------
# Password for accessing Tabminal web interface
# IMPORTANT: Change this to a strong password!
TABMINAL_PASSWORD=your-secure-password-here

# Accept security terms (REQUIRED for production)
# Set to 'true' to acknowledge security risks
TABMINAL_ACCEPT=true

# AI Features (Optional)
# ------------------
# OpenRouter API Key for AI functionality
TABMINAL_OPENROUTER_KEY=your-openrouter-api-key

# AI Model to use
TABMINAL_MODEL=gemini-2.5-flash-preview-09-2025

# Google Search (Optional)
# ---------------------
# Google Search API Key
TABMINAL_GOOGLE_KEY=your-google-api-key

# Google Search Engine ID (CX)
TABMINAL_GOOGLE_CX=your-google-search-engine-id

# Advanced Options
# ---------------
# Debug mode (default: false)
TABMINAL_DEBUG=false

# Heartbeat interval in milliseconds (default: 10000)
# TABMINAL_HEARTBEAT=10000

# History limit in characters (default: 524288)
# TABMINAL_HISTORY=524288
